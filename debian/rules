#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Install systemd user units
	install -Dm644 share/systemd/ukm-notify.service \
		debian/ukm/usr/lib/systemd/user/ukm-notify.service
	install -Dm644 share/systemd/ukm-notify.timer \
		debian/ukm/usr/lib/systemd/user/ukm-notify.timer

override_dh_python3:
	dh_python3 --shebang=/usr/bin/python3
